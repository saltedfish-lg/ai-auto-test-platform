{
  "name": "@platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate:api": "python ../../tools/openapi_client.py generate",
    "check:api": "python ../../tools/openapi_client.py check"
  },
  "dependencies": {
    "element-plus": "2.14.3",
    "pinia": "3.0.3",
    "vue": "3.5.18",
    "vue-router": "4.5.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.62.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "3.0.6"
  }
}
