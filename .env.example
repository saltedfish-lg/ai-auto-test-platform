# Local-only examples for the current development baseline. Do not place real credentials or production endpoints here.
PLATFORM_ENVIRONMENT=local
PLATFORM_LOG_LEVEL=INFO
PLATFORM_DATABASE_URL=mysql+pymysql://platform_local:local_only@127.0.0.1:3306/ai_auto_test_platform

API_HOST=127.0.0.1
API_PORT=8000

# Generate these local-only files with: platform-api generate-dev-rsa-keys
ATP_JWT_PRIVATE_KEY_FILE=.runtime/secrets/jwt-private.pem
ATP_JWT_PUBLIC_KEY_FILE=.runtime/secrets/jwt-public.pem
ATP_JWT_KEY_ID=atp-local-rs256-v1
# Set only while running the explicit bootstrap-admin command.
ATP_BOOTSTRAP_ADMIN_PASSWORD_FILE=.runtime/secrets/bootstrap-admin-password

RUNNER_PLATFORM_URL=http://127.0.0.1:8000
RUNNER_WORK_DIR=.runtime/runner

VITE_API_BASE_URL=/
