# Local-only examples for the current development baseline. Replace placeholders locally;
# never place real credentials or production endpoints in this file.
PLATFORM_ENVIRONMENT=local
PLATFORM_LOG_LEVEL=INFO
ATP_DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/ai_auto_test_platform_dev
ATP_MYSQL_ADMIN_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/mysql

API_HOST=127.0.0.1
API_PORT=8000

# Generate a local JWT key-ring manifest with: platform-api generate-dev-rsa-keys
ATP_JWT_KEY_RING_FILE=.runtime/secrets/jwt-key-ring.json
# Required strict JSON secret key ring. It contains the active HMAC master key
# and optional previous keys retained for at least the governed 24-hour overlap.
ATP_AUTH_HMAC_MASTER_KEY_FILE=.runtime/secrets/auth-hmac-key-ring.json
ATP_TRUSTED_PROXY_CIDRS=
# Set only while running the explicit bootstrap-admin command.
ATP_BOOTSTRAP_ADMIN_PASSWORD_FILE=.runtime/secrets/bootstrap-admin-password

RUNNER_PLATFORM_URL=http://127.0.0.1:8000
RUNNER_WORK_DIR=.runtime/runner

VITE_API_BASE_URL=/
