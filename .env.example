# Local development example only. Never commit real credentials or key material.
PLATFORM_ENVIRONMENT=local
ATP_DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/ai_auto_test_platform_dev
ATP_MYSQL_ADMIN_URL=mysql+pymysql://<admin_user>:<admin_password>@127.0.0.1:3306/mysql
# Flyway CLI must be on PATH; set an absolute executable path here only when PATH resolution is unavailable.
FLYWAY_COMMAND=flyway
ATP_SCHEMA_PREFLIGHT_MODE=required
ATP_JWT_KEY_RING_FILE=/absolute/path/to/jwt-key-ring.json
ATP_AUTH_HMAC_MASTER_KEY_FILE=/absolute/path/to/auth-hmac-key-ring.json
ATP_MODEL_SECRET_KEY_RING_FILE=/absolute/path/to/model-secret-key-ring.json
ATP_LITELLM_PROXY_URL=https://litellm-proxy.example.internal
ATP_LITELLM_PROXY_API_KEY_FILE=/absolute/path/to/litellm-proxy-api-key.txt
# Keep false unless LiteLLM is deployed with fixed or request-isolated provider credentials.
ATP_LITELLM_DYNAMIC_CREDENTIALS_ENABLED=false
ATP_TRUSTED_PROXY_CIDRS=
ATP_BOOTSTRAP_ADMIN_PASSWORD_FILE=
API_HOST=127.0.0.1
API_PORT=8000
